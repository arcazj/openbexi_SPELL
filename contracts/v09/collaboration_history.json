    "text_diff": true,
    "metadata_diff": true,
    "rename_detection": true,
    "case_change_detection": true,
    "dependency_impact": true,
    "validation_delta": true,
    "bounded_context_lines": 20,
    "binary_diff": false
  },
  "conflict_kinds": [
