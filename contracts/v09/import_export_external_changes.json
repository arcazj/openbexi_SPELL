    "host_path_parameter": false,
    "remote_url_parameter": false,
    "network_fetch": false,
    "browser_filesystem_handle_persisted": false,
    "content_sha256_required": true
  },
  "archive_contract": {
    "media_type": "application/vnd.openbexi.spell.project+zip",
    "compression_methods": ["STORE", "DEFLATE"],
    "manifest_required": true,
    "relative_forward_slash_paths_only": true,
    "duplicate_paths": "REJECTED",
    "casefold_collisions": "REJECTED",
    "absolute_or_parent_paths": "REJECTED",
    "symlink_hardlink_reparse_or_device_entries": "REJECTED",
    "encrypted_entries": "REJECTED",
    "nested_archives": "REJECTED",
    "executable_bits": "CLEARED",
    "unknown_entry_type": "REJECTED"
  },
  "provenance": {
    "required_fields": [
      "operation_id",
      "actor_subject",
      "original_filename",
      "original_media_type",
      "original_byte_length",
      "original_bytes_sha256",
      "canonical_tree_sha256",
      "base_workspace_revision",
      "database_time"
    ],
    "original_bytes_retained": true,
    "source_executed": false,
    "promotable_before_blockers_resolved": false
  },
  "import_transaction": {
    "parse_and_validate_before_mutation": true,
    "expected_workspace_revision_required": true,
    "all_or_nothing": true,
    "partial_import": false,
    "conflicts_returned_before_commit": true,
    "audit_record_required": true
  },
  "external_change_detection": {
    "server_workspace_revision_is_authoritative": true,
    "client_base_revision_required": true,
    "changed_resource_digests_compared": true,
    "silent_refresh_or_overwrite": false,
    "outcome": "EXTERNAL_CHANGE_CONFLICT",
    "resolution_choices": ["RELOAD", "KEEP_AS_NEW_CHANGE", "THREE_WAY_MERGE"]
  },
  "case_and_rename_conflicts": {
    "normalized_unicode": "NFC",
    "path_separator": "/",
    "case_policy_from_project_manifest": true,
    "case_only_rename_uses_two_phase_server_operation": true,
    "rename_delete_collision": "RENAME_CONFLICT",
    "dependency_references_revalidated": true,
    "lost_update": false
  },
  "limits": {
    "maximum_archive_bytes": 67108864,
    "maximum_uncompressed_bytes": 67108864,
    "maximum_entries": 10000,
    "maximum_path_utf8_bytes": 512,
    "maximum_compression_ratio": 100,
    "maximum_import_seconds": 30
