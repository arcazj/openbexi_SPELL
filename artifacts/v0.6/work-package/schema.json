{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbexi.example/schemas/spell-v06-candidate-qualification-1.json",
  "title": "OpenBEXI SPELL v0.6 candidate qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "scope_profile",
    "source",
    "gate_0a",
    "contracts",
    "toolchain",
    "database",
    "suites",
    "work_packages",
    "assurance",
    "historical_platform_skips",
    "v0_5_immutability",
    "secret_scan",
    "artifacts",
    "teardown",
    "overall_pass"
  ],
  "properties": {
    "schema_version": {"const": "spell.v06.candidate-qualification/1"},
    "product_version": {"const": "0.6.0-candidate"},
    "scope_profile": {"const": "LOCAL_SYNTHETIC_NON_CUI_SIMULATOR"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "parent", "source_fingerprint_sha256", "product_fingerprint_sha256"],
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "tree": {"pattern": "^[0-9a-f]{40}$"},
        "parent": {"pattern": "^[0-9a-f]{40}$"},
        "source_fingerprint_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "product_fingerprint_sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "gate_0a": {"type": "object"},
    "contracts": {"type": "object"},
    "toolchain": {"type": "object"},
    "database": {"type": "object"},
    "suites": {"type": "object", "minProperties": 8},
    "work_packages": {
      "type": "object",
      "minProperties": 9,
      "maxProperties": 9,
      "patternProperties": {
        "^V06-OP-00[1-9]$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test_ids"],
          "properties": {
            "test_ids": {
              "type": "object",
              "minProperties": 5,
              "maxProperties": 5,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["proofs", "passed_count", "skipped_count"],
                "properties": {
                  "proofs": {"type": "array", "minItems": 1, "uniqueItems": true},
                  "passed_count": {"type": "integer", "minimum": 1},
                  "skipped_count": {"const": 0}
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "assurance": {"type": "object"},
    "historical_platform_skips": {"type": "object"},
    "v0_5_immutability": {
      "type": "object",
      "required": [
        "baseline_tag",
        "baseline_tree_fingerprint_sha256",
        "source_tree_fingerprint_sha256",
        "git_diff_empty",
        "accepted_archive_path",
        "accepted_archive_sha256",
        "accepted_sidecar_path",
        "accepted_sidecar_sha256",
        "accepted_tag_object",
        "accepted_tag_archive_claim"
      ],
      "properties": {
        "baseline_tag": {"const": "v0.5.0"},
        "baseline_tree_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_tree_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_diff_empty": {"const": true},
        "accepted_archive_path": {"const": "artifacts/v0.5/openbexi-spell-v0.5.0.tar.gz"},
        "accepted_archive_sha256": {"const": "cec956dd89da4c978ad5036c2a7854ff31284123d6193838f26c4298c50f6241"},
        "accepted_sidecar_path": {"const": "artifacts/v0.5/openbexi-spell-v0.5.0.tar.gz.sha256"},
        "accepted_sidecar_sha256": {"const": "215ee4e79fd53fccd04e6ff7d854d9a8d03f074f507d6fbf233926be9e817279"},
        "accepted_tag_object": {"const": "a1b277d74d2fb19062ca3e4388e9104d45c50ec4"},
        "accepted_tag_archive_claim": {"const": "Final archive SHA-256: cec956dd89da4c978ad5036c2a7854ff31284123d6193838f26c4298c50f6241"}
      },
      "additionalProperties": false
    },
    "secret_scan": {"type": "object"},
    "artifacts": {"type": "object"},
    "teardown": {"type": "object"},
    "overall_pass": {"const": true}
  }
}
