{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbexi.example/schemas/spell-v07-candidate-qualification-1.json",
  "title": "OpenBEXI SPELL v0.7 candidate qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "scope_profile",
    "source",
    "gate_0a",
    "contracts",
    "toolchain",
    "database",
    "suites",
    "work_packages",
    "assurance",
    "historical_platform_skips",
    "v0_6_immutability",
    "secret_scan",
    "artifacts",
    "teardown",
    "overall_pass"
  ],
  "properties": {
    "schema_version": {"const": "spell.v07.candidate-qualification/1"},
    "product_version": {"const": "0.7.0-candidate"},
    "scope_profile": {"const": "LOCAL_SYNTHETIC_NON_CUI_SIMULATOR"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "parent", "source_fingerprint_sha256", "product_fingerprint_sha256"],
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$"},
        "tree": {"pattern": "^[0-9a-f]{40}$"},
        "parent": {"pattern": "^[0-9a-f]{40}$"},
        "source_fingerprint_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "product_fingerprint_sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "gate_0a": {"type": "object"},
    "contracts": {"type": "object"},
    "toolchain": {"type": "object"},
    "database": {"type": "object"},
    "suites": {"type": "object", "minProperties": 10, "maxProperties": 10},
    "work_packages": {
      "type": "object",
      "minProperties": 9,
      "maxProperties": 9,
      "patternProperties": {
        "^V07-OBS-00[1-9]$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test_ids"],
          "properties": {
            "test_ids": {
              "type": "object",
              "minProperties": 5,
              "maxProperties": 5,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["proofs", "passed_count", "skipped_count"],
                "properties": {
                  "proofs": {"type": "array", "minItems": 1, "uniqueItems": true},
                  "passed_count": {"type": "integer", "minimum": 1},
                  "skipped_count": {"const": 0}
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "assurance": {"type": "object"},
    "historical_platform_skips": {"type": "object"},
    "v0_6_immutability": {
      "type": "object",
      "required": [
        "baseline_tag",
        "baseline_tree_fingerprint_sha256",
        "source_tree_fingerprint_sha256",
        "git_diff_empty",
        "accepted_archive_path",
        "accepted_archive_sha256",
        "accepted_sidecar_path",
        "accepted_sidecar_sha256",
        "accepted_tag_object",
        "accepted_tag_archive_claim"
      ],
      "properties": {
        "baseline_tag": {"const": "v0.6.0"},
        "baseline_tree_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_tree_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_diff_empty": {"const": true},
        "accepted_archive_path": {"const": "artifacts/v0.6/openbexi-spell-v0.6.0.tar.gz"},
        "accepted_archive_sha256": {"const": "b2d2bb30fe3ec781d8dcca434d3f0b90f8f31e2a776331c5ef20b36c8ae2864c"},
        "accepted_sidecar_path": {"const": "artifacts/v0.6/openbexi-spell-v0.6.0.tar.gz.sha256"},
        "accepted_sidecar_sha256": {"const": "7240872d3058796e7496eb9f0a44b44295a1246c6c991545aae4fb9b2ec23520"},
        "accepted_tag_object": {"const": "b6dc64dc8fb6cfe9845f454904a078ec6f3c0919"},
        "accepted_tag_archive_claim": {"const": "Final archive SHA-256: b2d2bb30fe3ec781d8dcca434d3f0b90f8f31e2a776331c5ef20b36c8ae2864c"}
      },
      "additionalProperties": false
    },
    "secret_scan": {"type": "object"},
    "artifacts": {"type": "object"},
    "teardown": {"type": "object"},
    "overall_pass": {"const": true}
  }
}
