    "host_process_launch": false,
    "host_environment_discovery": false,
    "python_interpreter_configuration": false
  },
  "diagnostic_contract": {
    "required_fields": [
      "diagnostic_id",
      "code",
      "severity",
      "source_path",
      "start_line",
      "start_column",
      "end_line",
      "end_column",
      "language_profile",
      "message",
      "remediation_ref",
      "tool_version"
    ],
    "stable_identity_inputs": [
      "workspace_revision",
      "source_digest",
