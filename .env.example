# Simulator-only v0.2 development settings. Do not use these credentials in a
# shared, staging, mission, Ground Control System, or spacecraft environment.
# This DATABASE_URL is for direct host execution; Compose overrides the host
# with its internal `postgres` service name.
DATABASE_URL=postgresql+psycopg://spell:spell-dev-only@127.0.0.1:5432/spell
SPELL_PROCEDURES_DIR=procedures
SPELL_DEV_AUTH_TOKEN=spell-dev-token
SPELL_WS_REPLAY_LIMIT=1000
SPELL_WS_QUEUE_SIZE=256
SPELL_WS_KEEPALIVE_SECONDS=5
# VITE_* values are read by the frontend development/build process.
VITE_SPELL_TOKEN=spell-dev-token
VITE_SPELL_ACTOR=console.admin
VITE_SPELL_ROLE=admin
