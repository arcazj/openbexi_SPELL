# SPELL v0.9 simulator-only local settings. Never reuse these values outside a
# single developer workstation. Copy to `.env` and populate both secrets.
SPELL_DB_PASSWORD=
SPELL_JWT_HS256_SECRET=

SPELL_JWT_ISSUER=openbexi-spell-local
SPELL_JWT_AUDIENCE=openbexi-spell-api
SPELL_JWT_MAX_LIFETIME_SECONDS=900
SPELL_JWT_CLOCK_SKEW_SECONDS=30

# Token issuance remains disabled unless explicitly enabled for a local test.
# The helper additionally requires a loopback peer and emits short-lived JWTs.
SPELL_ALLOW_LOCAL_DEV_TOKEN=false

# Use URL-safe characters for SPELL_DB_PASSWORD because it is interpolated
# into DATABASE_URL. Generate SPELL_JWT_HS256_SECRET with at least 32 random
# bytes and do not commit `.env`.

SPELL_PROXY_PORT=8080
SPELL_WS_REPLAY_LIMIT=1000
SPELL_WS_QUEUE_SIZE=256
SPELL_WS_KEEPALIVE_SECONDS=5
SPELL_COMMAND_ACK_TIMEOUT_SECONDS=5

# The separate lifecycle-only simulator driver is disabled after install.
# Enable it only with the bundled Compose `driver` profile; arbitrary targets
# and external adapters are not accepted by the application configuration.
# Set this to true and start Compose with `--profile driver` for the isolated,
# local synthetic engineering simulator. This is not an operational mode.
SPELL_DRIVER_ENABLED=false
SPELL_DRIVER_RPC_TIMEOUT_SECONDS=2
SPELL_DRIVER_POLL_SECONDS=1
SPELL_DRIVER_STALE_AFTER_SECONDS=5
SPELL_OBSERVATION_POLL_SECONDS=0.2
SPELL_OBSERVATION_FRESHNESS_SWEEP_SECONDS=0.5

# Trusted server-owned storage for the three fixed v0.8 virtual roots. This
# path is never accepted from, or returned through, the public data API.
SPELL_DATA_DIR=/var/lib/openbexi-spell/data

# Existing server-owned directory probed before the v0.8 schema migration.
SPELL_V0007_BACKUP_DIR=/var/lib/openbexi-spell/migration-backups
